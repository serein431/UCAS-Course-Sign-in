[Unit]
Description=UCAS course sign-in web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ucas-sign-in
Group=ucas-sign-in
WorkingDirectory=/opt/ucas-sign-in/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=19300
Environment=TRUST_PROXY_HEADERS=true
Environment=PUBLIC_ORIGIN=https://app.corvusapi.org
ExecStart=/opt/ucas-sign-in/runtime/node-v24.14.1-linux-x64/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ucas-sign-in/cache
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
